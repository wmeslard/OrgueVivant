# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-public-key

# Site
SITE_URL=https://orgue-vivant.vercel.app

# Supabase service role (admin API — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (formulaire de contact)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO=contact@orguevivant.fr
CONTACT_FROM=Orgue Vivant <contact@orguevivant.fr>

# Vercel — revalidation ISR à la demande après modification dans l'admin
# Générer un secret aléatoire (32+ caractères) : openssl rand -hex 32
VERCEL_BYPASS_TOKEN=
